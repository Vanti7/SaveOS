# Fichier d'exemple des variables d'environnement pour SaveOS
# Copiez ce fichier vers .env et adaptez les valeurs

# Configuration de la base de données
DATABASE_URL=postgresql://saveos:saveos123@localhost:5432/saveos

# Configuration Redis
REDIS_URL=redis://localhost:6379/0

# Configuration API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Configuration TLS
SSL_CERT_PATH=certs/cert.pem
SSL_KEY_PATH=certs/key.pem

# Configuration MinIO
MINIO_ROOT_USER=saveos
MINIO_ROOT_PASSWORD=saveos123456
MINIO_ENDPOINT=localhost:9000

# Token statique du tableau de bord web (pont d'authentification temporaire
# MVP, voir docs/adr/0001-restauration-granulaire-mvp.md). Même valeur des
# deux côtés (api et web) ; à générer avec `openssl rand -hex 32` par exemple.
DASHBOARD_API_TOKEN=

# Dossier de stockage des paquets de restauration (volume partagé api/worker)
RESTORE_PACKAGE_DIR=/tmp/restore_packages

# Configuration de l'agent
AGENT_API_URL=https://localhost:8000
AGENT_VERIFY_SSL=false
AGENT_HEARTBEAT_INTERVAL=300

# Configuration du worker
WORKER_CONCURRENCY=2
WORKER_TIMEOUT=3600
# Port d'exposition des métriques Prometheus du worker (endpoint /metrics)
WORKER_METRICS_PORT=9200
# Dossier de fichiers du mode multiprocess prometheus_client (chaque job RQ
# s'exécute dans un processus enfant forké ; vidé au démarrage du worker)
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# Logging
LOG_LEVEL=INFO

# Mot de passe admin de Grafana (stack Prometheus/Grafana local, dev
# uniquement — voir docker-compose.yml). Sans effet en production, où le
# monitoring est externe (Grafana + Zabbix).
GRAFANA_PASSWORD=admin